{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "82c4f4b23dd3b5e81502a03d73cfe8a3",
  "name": "email-frontend",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [{
    "pattern": "email.slyxup.com",
    "custom_domain": true
  }],
  "vars": { "APP_NAME": "SlyxUp Mail" }
}
