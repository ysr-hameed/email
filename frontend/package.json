{
  "name": "slyxup-mail-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --port 4173",
    "deploy": "npm run build && wrangler pages deploy dist --project-name mail-slyxup-online --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@slyxup/mail-shared": "file:../shared",
    "dompurify": "^3.2.5",
    "@vitejs/plugin-react": "^4.4.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "tailwindcss": "^4.1.7",
    "@tailwindcss/vite": "^4.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/dompurify": "^3.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "wrangler": "^4.13.0"
  }
}
