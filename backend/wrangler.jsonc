{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "ed01399ae5f7a46697e0802e4eaef6a9",
  "name": "email-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": true,
  "vars": {
    "MAIL_ADMIN_EMAIL": "slyxup@gmail.com",
    "MAIL_ADMIN_NAME": "SlyxUp",
    "MAIL_DOMAIN": "slyxup.com",
    "FRONTEND_ORIGIN": "https://email.slyxup.com"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "slyxup_email",
    "database_id": "ef00f847-57de-4416-a3d3-932e47b36861",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "ATTACHMENTS",
    "bucket_name": "slyxup-email-attachments-v2"
  }],
  "kv_namespaces": [{
    "binding": "RATE_LIMIT",
    "id": "1e2295daff41414fa4f18c9c1c57d40d"
  }],
  "routes": [{
    "pattern": "mail-api.slyxup.com",
    "custom_domain": true
  }]
}
